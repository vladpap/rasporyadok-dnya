{
  "name": "rasporyadok-dnya",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "node scripts/build-schedule.mjs",
    "data:check": "node scripts/build-schedule.mjs --check",
    "import": "node scripts/import-schedule.mjs",
    "test": "node --test scripts/tests/*.test.mjs",
    "dev": "npm run data && vite",
    "build": "npm run data && tsc --noEmit && vite build",
    "smoke": "npm run data && vite build --ssr src/smoke/app-smoke.tsx --outDir .smoke --logLevel error && node scripts/run-smoke.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.0",
    "@astryxdesign/theme-neutral": "^0.7.0",
    "@stylexjs/stylex": "^0.19.1",
    "@supabase/supabase-js": "^2.109.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
